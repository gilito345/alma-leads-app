# Copy to .env, then fill in the values marked REQUIRED.
# The containers read this file when they start: after editing it, run `docker compose up -d`.

# ---- Supabase: database ----
# Postgres started by `supabase start` (user/password postgres, port 54322).
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:54322/postgres

# ---- Supabase: Auth + Storage ----
# How the backend containers reach Supabase's API gateway on your machine.
SUPABASE_URL=http://host.docker.internal:54321
# REQUIRED: the "Publishable" and "Secret" keys printed by `supabase start` / `supabase status`.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only for projects still signing tokens with a legacy HS256 secret. Local Supabase and new
# hosted projects use asymmetric keys (verified via JWKS), so leave this empty.
SUPABASE_JWT_SECRET=
STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=resumes

# ---- Attorney accounts ----
# There's no public sign-up. Create the first attorney with the CLI (see README); after that,
# attorneys invite colleagues by email from the dashboard. Invite and password-reset links
# expire after this many hours; keep it equal to otp_expiry in supabase/config.toml.
AUTH_LINK_EXPIRY_HOURS=24

# ---- Email (Resend) ----
# REQUIRED for real delivery. Leave empty to have the worker log emails instead of sending.
RESEND_API_KEY=
# Without a verified domain in Resend, keep onboarding@resend.dev: it only delivers to
# the email address that owns your Resend account.
EMAIL_FROM=Leads <onboarding@resend.dev>
# REQUIRED: where new-lead notifications go.
ATTORNEY_NOTIFICATION_EMAIL=attorney@example.com

# ---- Web ----
# Public URL of the web app (used in email links and CORS; https:// enables Secure cookies).
WEB_ORIGIN=http://localhost:3000
# How the web server reaches the API.
API_INTERNAL_URL=http://api:8000
