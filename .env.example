# ---- Postgres ----
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads
POSTGRES_DB=leads
DATABASE_URL=postgresql+psycopg://leads:leads@db:5432/leads

# ---- Object storage (MinIO locally, S3 in production) ----
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=resumes
S3_REGION=us-east-1

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=480

# ---- Email (Resend) ----
# Leave RESEND_API_KEY empty to log emails to the worker's console instead of sending.
RESEND_API_KEY=
# Without a verified domain in Resend, use onboarding@resend.dev; it only delivers
# to your own Resend account address.
EMAIL_FROM="Leads <onboarding@resend.dev>"
ATTORNEY_NOTIFICATION_EMAIL=attorney@example.com

# ---- Web / CORS ----
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
