# Copy to .env and fill in the values marked REQUIRED. Defaults work for local Docker.

# ---- Postgres ----
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads
POSTGRES_DB=leads
DATABASE_URL=postgresql+psycopg://leads:leads@db:5432/leads

# ---- Resume storage ----
# "local" keeps files on a Docker volume (development). "s3" uses the S3 settings below.
STORAGE_BACKEND=local
# S3_BUCKET=my-leads-resumes
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=          # only for S3-compatible services other than AWS

# ---- Auth ----
# At least 32 characters. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-only-secret-change-me-before-deploying
JWT_EXPIRES_MINUTES=480
# The first attorney account can be created at /signup with no code. After that, new
# accounts need this invite code. Leave empty to close sign-up once the first account exists.
ATTORNEY_SIGNUP_CODE=

# ---- Email (Resend) ----
# REQUIRED for real delivery. Leave empty to have the worker log emails instead of sending.
RESEND_API_KEY=
# Without a verified domain in Resend, keep onboarding@resend.dev: it only delivers to
# the email address that owns your Resend account.
EMAIL_FROM=Leads <onboarding@resend.dev>
# REQUIRED: where new-lead notifications go.
ATTORNEY_NOTIFICATION_EMAIL=attorney@example.com

# ---- Web ----
# Public URL of the web app (used in email links and CORS; https:// enables Secure cookies).
WEB_ORIGIN=http://localhost:3000
# How the web server reaches the API.
API_INTERNAL_URL=http://api:8000
